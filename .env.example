# =============================================================================
# EasyWedd Pro — environment template
# Copy to .env.local for local development. Never commit secrets.
# =============================================================================

# App URL — ONE value only. Local development:
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Production (set in Cloudflare Worker Variables, not in .env.local):
# NEXT_PUBLIC_APP_URL=https://easyweddpro.raianvisual.ro
# NEXT_PUBLIC_SITE_URL=https://easyweddpro.raianvisual.ro

# Staging example:
# NEXT_PUBLIC_APP_URL=https://staging-easyweddpro.raianvisual.ro

# Optional environment badge for admin UI
# NEXT_PUBLIC_APP_ENV=development

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional integrations
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# CRON_SECRET=
