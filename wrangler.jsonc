{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Canonical Worker for https://easyweddpro.raianvisual.ro — OpenNext app (not Hello-world starter).
  "name": "easyweddpro-raianvisual-ro",
  // OpenNext custom worker: re-exports `.open-next/worker.js` + cron `scheduled()`.
  "main": "worker.ts",
  "compatibility_date": "2026-08-06",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "easyweddpro-raianvisual-ro"
    }
  ],
  "routes": [
    {
      "pattern": "easyweddpro.raianvisual.ro",
      "custom_domain": true
    }
  ],
  "triggers": {
    "crons": ["0 * * * *"]
  },
  "minify": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true
    }
  }
}
